# ---- Security ---------------------------------------------------------------
# production (default): X-API-Key required, roles bound server-side from users.json.
# development: client-declared roles and OPEN admin endpoints. Local use only!
SECURITY_ENV=development
# Comma-separated browser origins allowed to call the API (empty = same-origin only).
CORS_ORIGINS=

# ---- Model providers (at least one) -----------------------------------------
GROQ_API_KEY=
GEMINI_API_KEYS=            # comma-separated for key rotation
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Storage ------------------------------------------------------------------
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql+psycopg2://shield:password@localhost:5432/agentshield

# ---- Active learning -----------------------------------------------------------
# Where phrases learned via /api/threats/learn are persisted (writable path in Docker).
# THREAT_VECTORS_PATH=./backend/app/config/threat_vectors.json

# ---- Evaluation dashboard ------------------------------------------------------
# Folder holding run folders written by `python -m evaluation` (read by the admin dashboard).
# EVAL_RESULTS_DIR=./backend/evaluation/results

# ---- Tuning (optional) ----------------------------------------------------------
# ALLOW_MAX=25
# WARN_MAX=55
# APPROVE_MAX=80
# MAX_AGENT_STEPS=6
# CODE_EXEC_TIMEOUT_S=5
# REDACT_EMAILS=true
# SPOTLIGHT_TOOL_OUTPUT=true
# AGENT_SHIELD_DISABLE_EMBEDDINGS=0   # 1 = keyword fallback only (no torch needed)
