{
  "active_strategy": "priority_failover",
  "providers": [
    {
      "id": "google-gemini",
      "name": "Google Gemini (1.5 Flash)",
      "type": "gemini",
      "model": "gemini-1.5-flash",
      "api_keys": ["${GEMINI_API_KEYS}", "${GEMINI_API_KEY}"],
      "enabled": true,
      "timeout_seconds": 15
    },
    {
      "id": "groq-cloud",
      "name": "Groq Cloud (GPT-OSS 120B)",
      "type": "groq",
      "model": "openai/gpt-oss-120b",
      "api_keys": ["${GROQ_API_KEY}"],
      "enabled": true,
      "timeout_seconds": 10
    },
    {
      "id": "local-ollama",
      "name": "Local Ollama (Llama 3.1)",
      "type": "openai_compatible",
      "model": "llama3.1:8b",
      "base_url": "${OLLAMA_BASE_URL:-http://localhost:11434/v1}",
      "api_key": "ollama",
      "enabled": false,
      "timeout_seconds": 5
    }
  ]
}
